      <item>
        <titleType>Official Title as Introduced</titleType>
        <titleTypeCode>6</titleTypeCode>
        <title>To amend the Elementary and Secondary Education Act of 1965 to exclude certain instructional approaches from comprehensive literacy instruction, to prioritize certain funds to promote the use of evidence-based literacy instruction and supports aligned to the science of reading, and for other purposes.</title>
