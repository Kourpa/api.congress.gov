      <item>
        <titleType>Official Title as Introduced</titleType>
        <titleTypeCode>6</titleTypeCode>
        <title>To direct the Secretary of Commerce to promote competitiveness in biomanufacturing in the United States, identify supply-chain and commercialization vulnerabilities relating to critical biomanufacturing inputs and domestic production capacity, improve transparency regarding Federal processes applicable to biomanufactured products, and for other purposes.</title>
