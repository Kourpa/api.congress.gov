      <summary>
        <versionCode>00</versionCode>
        <actionDate>2025-03-27</actionDate>
        <actionDesc>Introduced in House</actionDesc>
        <updateDate>2026-04-15T15:11:53Z</updateDate>
        <text><![CDATA[<p><strong>Freedom from Unfair Gun Taxes Act of 2025</strong></p><p>This bill prohibits a state&nbsp;or any political subdivision of a state from imposing or collecting an excise tax on the sale&nbsp;of a firearm, ammunition, or any part or component of a firearm or ammunition by a manufacture or dealer.&nbsp;</p>]]></text>
      </summary>
    </summaries>
