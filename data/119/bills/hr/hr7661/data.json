  "introduced_at": "2026-02-24",
  "number": "7661",
  "official_title": "To amend the Elementary and Secondary Education Act of 1965 to prohibit the use of funds provided under such Act to develop, implement, facilitate, host, or promote any program or activity for, or to provide or promote literature or other materials to, children under the age of 18 that includes sexually oriented material, and for other purposes.",
  "popular_title": null,
