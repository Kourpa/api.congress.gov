  "introduced_at": "2026-07-13",
  "number": "9641",
  "official_title": "To amend titles XVIII and XIX of the Social Security Act to require certain facilities to permit visits from an essential caregiver during certain periods.",
  "popular_title": null,
  "related_bills": [],
  "short_title": "Essential Caregivers Act of 2026",
  "sponsor": {
    "bioguide_id": "T000478",
    "district": "24",
    "name": "Tenney, Claudia",
    "state": "NY",
