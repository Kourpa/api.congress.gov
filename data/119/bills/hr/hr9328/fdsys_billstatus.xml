    <summaries>
      <summary>
        <versionCode>00</versionCode>
        <actionDate>2026-06-18</actionDate>
        <actionDesc>Introduced in House</actionDesc>
        <updateDate>2026-07-08T17:27:15Z</updateDate>
        <text><![CDATA[<p><strong>Improving Travel for Military Members Act</strong></p><p>This bill allows the Transportation Security Administration (TSA) to establish a pilot program to expedite access to security screening for traveling active-duty military personnel and accompanying family members.</p><p>In selecting airports to participate in the pilot program, TSA must give priority to airports in proximity to certain military installations.</p>]]></text>
      </summary>
    </summaries>
