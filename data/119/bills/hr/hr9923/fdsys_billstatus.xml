      <item>
        <titleType>Official Title as Introduced</titleType>
        <titleTypeCode>6</titleTypeCode>
        <title>To demonstrate United States leadership and to engage successfully in biotechnology diplomacy by recruiting and training biotechnology experts that can advocate for United States biotechnology priorities internationally, to ensure that Regional Technology Officers receive specialized training in biotechnology, and for other purposes.</title>
        <updateDate>2026-07-30T03:18:46Z</updateDate>
