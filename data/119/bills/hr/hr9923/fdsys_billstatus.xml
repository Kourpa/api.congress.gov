        <title>Biotechnology Diplomacy and Expertise Enhancement Act of 2026</title>
        <updateDate>2026-07-30T03:23:22Z</updateDate>
        <billTextVersionName>Introduced in House</billTextVersionName>
        <billTextVersionCode>IH</billTextVersionCode>
