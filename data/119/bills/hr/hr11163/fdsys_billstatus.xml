      <item>
        <titleType>Official Title as Introduced</titleType>
        <titleTypeCode>6</titleTypeCode>
        <title>To amend title XIX of the Social Security Act to make all children eligible for Medicaid from birth until age 26, to require States to automatically enroll children and young adults under age 26 in the State Medicaid program, and for other purposes.</title>
        <updateDate>2026-11-25T10:18:50Z</updateDate>
