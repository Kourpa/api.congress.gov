  "introduced_at": "2026-08-27",
  "number": "10159",
  "official_title": "To authorize the Secretary of the Army to convey to the State of North Carolina a certain parcel of real property located at Fort Bragg, North Carolina, on which the State shall construct a veterans' State home, and for other purposes.",
  "popular_title": null,
  "related_bills": [],
  "short_title": null,
  "sponsor": {
    "bioguide_id": "H001067",
    "district": "9",
    "name": "Hudson, Richard",
    "state": "NC",
    "title": "Rep.",
    "type": "person"
  },
  "status": "REFERRED",
  "status_at": "2026-08-27",
  "subjects": [
    "Armed forces and national security"
  ],
  "subjects_top_term": "Armed forces and national security",
  "summary": {
    "as": "Introduced in House",
    "asOf": "2026-08-27",
    "date": "2026-09-09T20:33:04Z",
    "text": "This bill authorizes the Department of the Army to transfer, without compensation or other consideration, all right, title, and interest to a specified 20-acre parcel of land on\u00a0Fort Bragg to the State of North Carolina for the purpose of constructing a state home under the jurisdiction of the North Carolina Department of Military and Veterans Affairs. (A state home is a home established by a state for veterans who are disabled by age, disease, or otherwise and are incapable of earning a living because of such disability. The term also includes a home that furnishes nursing home care for veterans.)\n\nSpecifically, the bill authorizes the conveyance of a 20-acre parcel of land situated on the Fort\u00a0Bragg Training Area in Harnett County, North Carolina, that is commonly referred to as Parcel 3B.\n\nThe State of North Carolina must cover all costs to carry out the conveyance.\n\nIf the Department\u00a0of the Army determines the property is not being used for activities related to a state home, all right, title, and interest in the property may revert to the United States."
  },
