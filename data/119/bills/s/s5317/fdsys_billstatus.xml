        <titleTypeCode>101</titleTypeCode>
        <title>Inspiring New STEM Professionals by Investing in Renovation of Education Spaces Act</title>
        <updateDate>2026-08-13T02:53:42Z</updateDate>
        <billTextVersionName>Introduced in Senate</billTextVersionName>
        <billTextVersionCode>IS</billTextVersionCode>
      </item>
      <item>
        <titleType>Official Title as Introduced</titleType>
        <titleTypeCode>6</titleTypeCode>
        <title>A bill to enable schools serving grades 6 through 12 that are located in rural areas or that serve Native American students to remodel or build new facilities to provide STEM classrooms and laboratories and support high-speed internet, to establish a program to support the modernization, renovation, or repair of career and technical education facilities, and for other purposes.</title>
        <updateDate>2026-08-13T02:48:43Z</updateDate>
        <billTextVersionName>Introduced in Senate</billTextVersionName>
        <billTextVersionCode>IS</billTextVersionCode>
