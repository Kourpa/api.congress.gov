    <summaries>
      <summary>
        <versionCode>25</versionCode>
        <actionDate>2026-07-16</actionDate>
        <actionDesc>Reported to Senate</actionDesc>
        <updateDate>2026-07-22T19:26:24Z</updateDate>
        <text><![CDATA[<p><strong>EARLY Act Reauthorization of 2025</strong></p><p>This bill reauthorizes through FY2031 programs relating to young women’s awareness of breast health and breast cancer, which are administered by the Centers for Disease Control and Prevention. These programs include campaigns to educate young women and health care professionals, research on preventing breast cancer in younger women, and grants for resources and services to young women diagnosed with breast cancer and precancerous conditions.</p>]]></text>
      </summary>
    </summaries>
