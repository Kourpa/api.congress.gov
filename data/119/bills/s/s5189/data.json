  "introduced_at": "2026-07-30",
  "number": "5189",
  "official_title": "A bill to amend title 10, United States Code, and the National Defense Authorization Act for Fiscal Year 1994, to codify and clarify gender neutral standards for members of certain Armed Forces, and for other purposes.",
  "popular_title": null,
  "related_bills": [
    {
      "bill_id": "hr8175-119",
      "identified_by": "CRS",
      "reason": "related",
      "type": "bill"
    }
  ],
